library(rsm)
ether <- data.frame(
run = 1:30,
temp = c(10, 20, 10, 20, 10, 20, 10, 20, 10, 20,
10, 20, 10, 20, 10, 20, 5, 25, 15, 15,
15, 15, 15, 15, 15, 15, 15, 15, 15, 15),
time = c(19, 19, 25, 25, 19, 19, 25, 25, 19, 19,
25, 25, 19, 19, 25, 25, 22, 22, 16, 28,
22, 22, 22, 22, 22, 22, 22, 22, 22, 22),
solvent = c(5, 5, 5, 5, 7, 7, 7, 7, 5, 5, 5, 5,
7, 7, 7, 7, 6, 6, 6, 6, 4, 8, 6, 6,
6, 6, 6, 6, 6, 6),
reagent = c(1, 1, 1, 1, 1, 1, 1, 1, 1.33, 1.33,
1.33, 1.33, 1.33, 1.33, 1.33, 1.33,
1.165, 1.165, 1.165, 1.165, 1.165,
1.165, 0.835, 1.495, 1.165, 1.165,
1.165, 1.165, 1.165, 1.165),
yield = c(82.93, 94.04, 88.07, 93.97, 77.21, 92.99,
83.60, 94.38, 88.68, 94.30, 93.00, 93.42,
84.86, 94.26, 88.71, 94.66, 75.82, 93.25,
89.78, 94.61, 94.13, 89.94, 88.21, 93.11,
93.32, 92.32, 93.68, 93.27, 92.87, 92.96)
)
ether <- coded.data(ether, x1 ~ (temp - 15) / 5,
x2 ~ (time - 22) / 3,
x3 ~ (solvent - 6) / 1,
x4 ~ (reagent - 1.165) / .165)
print(ether, decode = F)
pharma1.rsm <- rsm(yield ~ FO(x1, x2, x3, x4),
data = ether,
subset = c(1:16, 25:30))
summary(pharma1.rsm)$lof
ggplot(data.frame(fitted = fitted(pharma1.rsm),
sresiduals = rstandard(pharma1.rsm)),
aes(x = fitted, y = sresiduals)) +
geom_point() +
theme_classic(base_size = 15) +
theme(aspect.ratio = 1,
plot.title=element_text(size=15)) +
labs(x = "Fitted values",
y = "Standardised residuals"
) +
grids()
ggplot(data.frame(fitted = fitted(pharma1.rsm),
sresiduals = rstandard(pharma1.rsm)),
aes(x = fitted, y = sresiduals)) +
geom_point() +
theme_classic(base_size = 15) +
theme(aspect.ratio = 1,
plot.title=element_text(size=15)) +
labs(x = "Fitted values",
y = "Standardised residuals"
) +
grids()
pharma2.rsm <- rsm(yield ~ SO(x1, x2, x3, x4),
data = ether)
summary(pharma2.rsm)$lof
summary(pharma2.rsm)$canonical$xs
## x1 x2 x3 x4
## 2.231 -1.873 2.081 -0.461
summary(pharma2.rsm)$canonical$eigen$values
