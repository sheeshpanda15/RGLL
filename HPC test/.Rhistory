)
nuclease <- nuclease |> mutate(across(temp:baffles,
~factor(.x))) |>
mutate(across(temp:baffles,
~ C(.x, contr = \(.) -1* contr.sum(.))))
nuclease.lm <- lm(nuclease ~ (.)^3,
data = nuclease)
hnplot(2 * coef(nuclease.lm)[-1], method = "Lenth",
horiz = F, ID = 2)
bact.frf2 <- FrF2(nruns = 8, nfactors = 5,
generators = list(c(1, 3), c(2, 3)),
factor.names = list(G = c(1, 2),
N = c(5, 7),
A = c(0, 1),
T = c(25, 35),
S = c(3, 5)))
bact.frf2 |>
kable(booktabs = T, linesep = ""
, escape = F,
caption = "Fractional factorial design for
the bacteriocin experiment from
\\texttt{FrF2}.")
aliases(lm(rnorm(8) ~ (.)^5, data = bact.frf2))
