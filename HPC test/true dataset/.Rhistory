cabbage <- data.frame(
cage = rep(1:10, rep(3, 10)),
species = c("cabbage", "cauliflower", "broccoli",
"cabbage", "cauliflower", "sprouts",
"cabbage", "broccoli", "kale",
"cabbage", "sprouts", "romanesco",
"cabbage", "kale", "romanesco",
"cauliflower", "broccoli", "romanesco",
"cauliflower", "sprouts", "kale",
"cauliflower", "kale", "romanesco",
"broccoli", "sprouts", "kale",
"broccoli", "sprouts", "romanesco"),
no.eggs = c(452, 69, 83, 802, 143, 53, 699, 32, 4,
1207, 19, 32, 958, 8, 8, 328, 147, 53,
314, 264, 223, 158, 36, 5, 117, 14,
115, 23, 16, 2)
)
cabbage <- cabbage |>
mutate(across(cage:species, ~ factor(.x))) |>
mutate(species = factor(species, c("cabbage",
"cauliflower",
"broccoli",
"sprouts",
"kale",
"romanesco"))) |>
mutate(across(cage:species,
~ C(.x, contr = \(.) contr.sum(.))))
cabbage.lm <- lm(sqrt(no.eggs) ~
cage + species,
data = cabbage)
print(anova(cabbage.lm), signif.legend = F)
tau <- c(coef(cabbage.lm)[11:15], -sum(coef(cabbage.lm)[11:15]))
names(tau) <- levels(cabbage$species)
data.frame(tau)
cabbage.em <- emmeans(cabbage.lm, ~ species)
transform(pairs(cabbage.em))
data.frame(tau)
cabbage.em <- emmeans(cabbage.lm, ~ species)
