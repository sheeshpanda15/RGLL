ricek3 <- bibd(v = 10, k = 3, b = 30, r = 9, l = 2)
ricek4 <- bibd(v = 10, k = 4, b = 15, r = 6, l= 2)
ricek5 <- bibd(v = 10, k = 5, b = 18, r = 9, l = 4)
ricek6 <- bibd(v = 10, k = 6, b = 15, r = 9, l = 5)
ricek9 <- bibd(v = 10, k = 9, b = 10, r = 9, l = 8)
riceDk4 <- optBlock(~
., factor(1:10),
blocksizes = rep(4, 10))
riceDk4.df <- matrix(riceDk4$rows, byrow = T,
nrow = 10)
rownames(riceDk4.df) <- paste0("Block-", 1:10)
colnames(riceDk4.df) <- paste("Unit", 1:4)
riceDk4.df
tcrossprod(table(riceDk4$rows,
c(rep(1:10, rep(4, 10)))))
spacing <- c("30 cm", "24 cm", "20 cm", "15 cm")
com <- combinations(4, 2, repeats.allowed = T)
rice.expt <- data.frame(
treatment = factor(paste(spacing[com[, 1]], "x",
spacing[com[, 2]])),
block = factor(rep(1:4, rep(10, 4))),
y = c(5.95, 7.10, 7.00, 8.10, 8.85, 7.65, 7.80, 8.05,
9.30, 9.35,5.30, 6.45, 6.50, 5.50, 7.65, 6.90,
6.75, 6.65, 8.75, 8.10, 6.50, 6.60, 6.35, 6.60,
7.00, 8.25, 8.20, 8.10, 8.75, 7.60, 6.35, 5.75,
8.90, 7.50, 7.90, 8.30, 7.25, 8.05, 8.00, 7.75)
)
rice.expt <- rice.expt |>
mutate(across(treatment:block,
~ C(.x, contr = \(.) contr.sum(.))))
rice.lm <- lm(y ~ block + treatment, data = rice.expt)
print(anova(rice.lm), signif.legend = F)
mtau <- coef(rice.lm)[1] + c(coef(rice.lm)[5:13],
-sum(coef(rice.lm)[5:13]))
names(mtau) <- levels(rice.expt$treatment)
sizes <- unlist(str_extract_all(names(mtau),
"[[:digit:]]+"))
area <- matrix(as.numeric(sizes), byrow = T, nrow = 10)
area <- area[, 1] * area[, 2]
rice.area <- data.frame(
area = area,
yield = mtau
)
rice.area |>
ggplot(aes(x = area, y = yield)) +
geom_point() +
theme_classic(base_size = 15) +
theme(aspect.ratio = 1,
plot.title=element_text(size=15)) +
labs(x = expression(Area~(mˆ2)),
y = "Average yield"
) +
grids()
rice.expt2 <- data.frame(rice.expt,
area = sort(area, d = T))
area2.lm <- rsm(y ~ block + FO(area), rice.expt2)
print(summary(area2.lm)$lof, signif.legend = F)
