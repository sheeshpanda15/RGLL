rm(list=ls())
library(devtools)
library(ClusterR)
library(MASS)
library(mvtnorm)
library(tidyr)
library(dplyr)
Rcpp::sourceCpp("lmm_fast.cpp")
dat <- read.csv("student-mat.csv", header = TRUE, sep = ";")
dat$Student_ID <- seq_len(nrow(dat))
# 2. 宽表转长表 (Wide to Long)
# 将 G1, G2, G3 转换为重复测量的时间维度，这是拟合随机斜率的前提
# 转换后，每个学生会对应 3 行数据
dat_long <- dat %>%
pivot_longer(
cols = c("G1", "G2", "G3"),
names_to = "Time_Point",
values_to = "Score"
) %>%
mutate(Time = case_when(
Time_Point == "G1" ~ 1,
Time_Point == "G2" ~ 2,
Time_Point == "G3" ~ 3
))
# 3. 提取变量与标准化处理
# y 是我们的目标变量 (Score)
y_raw <- as.numeric(dat_long$Score)
y_std <- (y_raw - mean(y_raw)) / sd(y_raw)
# 确定特征矩阵 X
# 排除成绩原始列和 ID 列，保留 Time 列作为随机斜率的自变量
exclude_list <- c("Score", "Time_Point", "Student_ID", "G1", "G2", "G3")
X_colnames <- setdiff(colnames(dat_long), exclude_list)
X_matrix <- as.matrix(dat_long[, X_colnames])
# 对 X 进行线性缩放，映射到 [1, 1] 区间
for (j in seq_len(ncol(X_matrix))) {
min_val <- min(X_matrix[, j])
max_val <- max(X_matrix[, j])
if (max_val > min_val) {
X_matrix[, j] <- 2 * (X_matrix[, j] - min_val) / (max_val - min_val) - 1
} else {
X_matrix[, j] <- 0
}
}
# 4. 保持个体完整性的数据集划分 (70% 训练, 30% 测试)
# 注意：必须按 Student_ID 划分，确保一个人的 G1/G2/G3 轨迹不会被分到两个集里
set.seed(42)
all_student_ids <- unique(dat_long$Student_ID)
train_ids <- sample(all_student_ids, round(length(all_student_ids) * 0.7))
test_ids <- setdiff(all_student_ids, train_ids)
# 5. 定义封装函数以生成 Comp 函数所需的 List 结构
create_comp_input <- function(target_ids, long_df, X_full, y_full) {
# 筛选对应学生的行
row_indices <- which(long_df$Student_ID %in% target_ids)
# 按照 Student_ID 排序，确保相同学生的数据在内存块中是连续的
# 这是你的 C++ 核心算法正确读取组大小 (nc) 的必要条件
final_order <- order(long_df$Student_ID[row_indices])
selected_rows <- row_indices[final_order]
# 计算每组的大小 (对于当前长表，每个学生固定为 3 次观测)
group_sizes <- as.integer(table(long_df$Student_ID[selected_rows]))
list(
FXX = X_full[selected_rows, , drop = FALSE],
FY = as.matrix(y_full[selected_rows]),
nc = group_sizes,
R = length(group_sizes)
)
}
# 6. 生成最终的 dataset 对象
train_result <- create_comp_input(train_ids, dat_long, X_matrix, y_std)
test_result  <- create_comp_input(test_ids, dat_long, X_matrix, y_std)
dataset_student <- list(
FXX.train = train_result$FXX,
FY.train = train_result$FY,
nc.train = train_result$nc,
FXX.test = test_result$FXX,
FY.test = test_result$FY,
nc.test = test_result$nc,
R = train_result$R,
p = ncol(train_result$FXX)
)
# ── 运行 ───────────────────────────────────────────────────
result <- Comp(d_Fedu, obj.c = 0.1)
source("C:/Users/sheesh/Desktop/RGLL/HPC test/true dataset/student/truedataset_student.R", echo = TRUE)
dat <- read.csv("student-mat.csv", header = TRUE, sep = ";")
dat$Student_ID <- seq_len(nrow(dat))
# === 这是刚才漏掉的关键步骤：将文本类别转换为数字 ===
cat_cols <- c("school", "sex", "address", "famsize", "Pstatus",
"Mjob", "Fjob", "reason", "guardian",
"schoolsup", "famsup", "paid", "activities",
"nursery", "higher", "internet", "romantic")
for (col in cat_cols) {
dat[[col]] <- as.integer(as.factor(dat[[col]]))
}
# 2. 宽表转长表 (Wide to Long)
dat_long <- dat %>%
pivot_longer(
cols = c("G1", "G2", "G3"),
names_to = "Time_Point",
values_to = "Score"
) %>%
mutate(Time = case_when(
Time_Point == "G1" ~ 1,
Time_Point == "G2" ~ 2,
Time_Point == "G3" ~ 3
))
# 3. 提取变量与标准化处理
y_raw <- as.numeric(dat_long$Score)
y_std <- (y_raw - mean(y_raw)) / sd(y_raw)
# 确定特征矩阵 X
exclude_list <- c("Score", "Time_Point", "Student_ID", "G1", "G2", "G3")
X_colnames <- setdiff(colnames(dat_long), exclude_list)
# 此时所有列都已经变成数值了，可以直接放进矩阵
X_matrix <- as.matrix(dat_long[, X_colnames])
# 将 X 矩阵的每一列标准化到 [-1, 1] 区间
for (j in seq_len(ncol(X_matrix))) {
# 为了确保万无一失，强制转为数值型再计算
X_matrix[, j] <- as.numeric(X_matrix[, j])
min_val <- min(X_matrix[, j])
max_val <- max(X_matrix[, j])
if (max_val > min_val) {
X_matrix[, j] <- 2 * (X_matrix[, j] - min_val) / (max_val - min_val) - 1
} else {
X_matrix[, j] <- 0
}
}
# 4. 保持个体完整性的数据集划分 (70% 训练, 30% 测试)
set.seed(42)
all_student_ids <- unique(dat_long$Student_ID)
train_ids <- sample(all_student_ids, round(length(all_student_ids) * 0.7))
test_ids <- setdiff(all_student_ids, train_ids)
# 5. 定义封装函数
create_comp_input <- function(target_ids, long_df, X_full, y_full) {
row_indices <- which(long_df$Student_ID %in% target_ids)
final_order <- order(long_df$Student_ID[row_indices])
selected_rows <- row_indices[final_order]
group_sizes <- as.integer(table(long_df$Student_ID[selected_rows]))
list(
FXX = X_full[selected_rows, , drop = FALSE],
FY = as.matrix(y_full[selected_rows]),
nc = group_sizes,
R = length(group_sizes)
)
}
# 6. 生成最终的 dataset 对象
train_result <- create_comp_input(train_ids, dat_long, X_matrix, y_std)
test_result  <- create_comp_input(test_ids, dat_long, X_matrix, y_std)
dataset_student <- list(
FXX.train = train_result$FXX,
FY.train = train_result$FY,
nc.train = train_result$nc,
FXX.test = test_result$FXX,
FY.test = test_result$FY,
nc.test = test_result$nc,
R = train_result$R,
p = ncol(train_result$FXX)
)
# ── 运行 ───────────────────────────────────────────────────
result <- Comp(d_Fedu, obj.c = 0.1)
source("C:/Users/sheesh/Desktop/RGLL/HPC test/true dataset/student/truedataset_student.R", echo = TRUE)
